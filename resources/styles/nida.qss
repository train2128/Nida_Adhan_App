/* Nida stylesheet template. @tokens are replaced from the palette in
   src/ui/theme.cpp, so dark and light share every rule. */

QWidget { color: @text; font-size: 13px; }
QLabel { background: transparent; }
QToolTip { background: @card; color: @text; border: 1px solid @line; padding: 4px 6px; }

/* ── Window surfaces ── */
QWidget#mainContainer, QWidget#notificationContainer {
    background-color: @bg;
    border: 1px solid @line;
    border-radius: 14px;
}
QWidget#notificationContainer { border: 1px solid @accentBorder; }
QDialog#settingsDialog { background-color: @bg; }

/* ── Main window ── */
QLabel#hijriDate { color: @gold; font-size: 14px; font-weight: 600; }
QLabel#miladiDate, QLabel#locationLabel, QLabel#methodLabel { color: @muted; font-size: 11px; }

QWidget#nextCard { background-color: @card; border-radius: 10px; }
QLabel#cardCaption { color: @muted; font-size: 11px; }
QLabel#nextName { font-size: 17px; font-weight: 600; }
QLabel#nextNameAr { color: @muted; font-size: 14px; }
QLabel#countdown { color: @accent; font-size: 22px; font-weight: 600; }

QProgressBar#nextProgress, QProgressBar#adhanProgress {
    background-color: @line;
    border: none;
    border-radius: 2px;
}
QProgressBar#nextProgress::chunk { background-color: @accent; border-radius: 2px; }
QProgressBar#adhanProgress::chunk { background-color: @gold; border-radius: 2px; }

QWidget#prayerRow { border-radius: 8px; border: 1px solid transparent; }
QWidget#prayerRow[state="next"] { background-color: @accentBg; border: 1px solid @accentBorder; }
QLabel#prayerName { font-size: 13px; }
QLabel#prayerNameAr { color: @muted; font-size: 12px; }
QLabel#prayerTime { font-size: 15px; font-weight: 600; }
QWidget#prayerRow[state="passed"] QLabel { color: @muted; }
QWidget#prayerRow[state="next"] QLabel#prayerName { font-weight: 600; }
QWidget#prayerRow[state="next"] QLabel#prayerNameAr,
QWidget#prayerRow[state="next"] QLabel#prayerTime { color: @accent; }

QPushButton#adhanToggle { background: transparent; border: none; border-radius: 6px; }
QPushButton#adhanToggle:hover { background-color: @hover; }

QFrame#footerSep { background-color: @line; color: @line; border: none; max-height: 1px; }

/* ── Buttons ── */
QPushButton#iconBtn {
    background: transparent;
    border: 1px solid @line;
    border-radius: 8px;
}
QPushButton#iconBtn:hover { background-color: @hover; border-color: @accentBorder; }
QPushButton#iconBtnFlat { background: transparent; border: none; border-radius: 6px; }
QPushButton#iconBtnFlat:hover { background-color: @hover; }

QPushButton#primaryBtn {
    background-color: @accent;
    color: @onAccent;
    border: 1px solid @accent;
    border-radius: 8px;
    padding: 7px 18px;
    font-weight: 600;
}
QPushButton#primaryBtn:hover { border-color: @text; }
QPushButton#primaryBtn:pressed { padding-top: 8px; padding-bottom: 6px; }

QPushButton#secondaryBtn {
    background: transparent;
    color: @text;
    border: 1px solid @line;
    border-radius: 8px;
    padding: 7px 14px;
}
QPushButton#secondaryBtn:hover { background-color: @hover; border-color: @accentBorder; }
QPushButton#secondaryBtn:disabled { color: @muted; }

/* ── Adhan popup ── */
QLabel#moonBadge { background-color: @accentBg; border-radius: 26px; }
QLabel#notifNameAr { font-size: 30px; font-weight: 600; }
QLabel#notifSubtitle { color: @muted; font-size: 13px; }
QLabel#notifReminder { color: @gold; font-size: 16px; }
QLabel#notifSmall { color: @muted; font-size: 11px; }

/* ── Settings ── */
QWidget#sidebar { background-color: @card; }
QLabel#sidebarTitle { color: @gold; font-size: 15px; font-weight: 600; padding-left: 6px; }
QListWidget#navList { background: transparent; border: none; outline: none; }
QListWidget#navList::item { color: @muted; border-radius: 8px; padding: 4px 8px; }
QListWidget#navList::item:hover:!selected { background-color: @hover; }
QListWidget#navList::item:selected { background-color: @accentBg; color: @accent; }

QLabel#pageTitle { font-size: 18px; font-weight: 600; }
QWidget#section { background-color: @card; border-radius: 10px; }
QLabel#sectionCaption { color: @muted; font-size: 11px; }
QLabel#savedLocation { font-size: 14px; }
QLabel#hint { color: @muted; font-size: 11px; }

QLineEdit, QComboBox {
    background-color: @bg;
    color: @text;
    border: 1px solid @line;
    border-radius: 8px;
    padding: 6px 10px;
    selection-background-color: @accent;
    selection-color: @onAccent;
}
QLineEdit:focus, QComboBox:focus { border-color: @accent; }
QComboBox::drop-down { border: none; width: 24px; }
QComboBox::down-arrow { image: url(:/icons/chevron_@mode); width: 12px; height: 12px; }
QComboBox QAbstractItemView {
    background-color: @card;
    color: @text;
    border: 1px solid @line;
    selection-background-color: @accentBg;
    selection-color: @text;
    outline: none;
}

QListWidget#resultsList, QListWidget#soundList {
    background-color: @bg;
    border: 1px solid @line;
    border-radius: 8px;
    padding: 3px;
    outline: none;
}
QListWidget#resultsList::item, QListWidget#soundList::item { border-radius: 6px; padding: 5px 6px; color: @text; }
QListWidget#resultsList::item:hover:!selected, QListWidget#soundList::item:hover:!selected { background-color: @hover; }
QListWidget#resultsList::item:selected, QListWidget#soundList::item:selected { background-color: @accentBg; color: @text; }
QWidget#soundRow { background: transparent; }

QCheckBox { spacing: 8px; }
QCheckBox::indicator {
    width: 16px; height: 16px;
    border-radius: 4px;
    border: 1px solid @line;
    background-color: @bg;
}
QCheckBox::indicator:hover { border-color: @accent; }
QCheckBox::indicator:checked { background-color: @accent; border-color: @accent; image: url(:/icons/check_@mode); }

QSlider::groove:horizontal { height: 4px; background: @line; border-radius: 2px; }
QSlider::sub-page:horizontal { background: @accent; border-radius: 2px; }
QSlider::handle:horizontal {
    background: @accent;
    width: 14px; height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

QScrollBar:vertical { background: transparent; width: 8px; margin: 2px; }
QScrollBar::handle:vertical { background: @line; border-radius: 4px; min-height: 24px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
